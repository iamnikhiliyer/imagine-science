{
  "name": "imagine-science",
  "version": "0.1.0",
  "description": "Editable scientific animations with a Codex skill, Remotion starter, and repeatable visual review.",
  "private": true,
  "license": "MIT",
  "author": "Nikhil Iyer",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamnikhiliyer/imagine-science.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts --no-open",
    "build": "remotion bundle src/index.ts",
    "doctor": "node skills/imagine-science/scripts/cli.mjs doctor",
    "validate": "node skills/imagine-science/scripts/cli.mjs validate",
    "review": "node skills/imagine-science/scripts/cli.mjs review",
    "render": "node skills/imagine-science/scripts/cli.mjs render",
    "verify": "node skills/imagine-science/scripts/cli.mjs verify",
    "contact-sheet": "node skills/imagine-science/scripts/cli.mjs contact-sheet",
    "lint": "eslint src && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm run lint && npm test"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.545"
  },
  "overrides": {
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.545",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.15.0",
    "typescript": "5.9.3"
  }
}
